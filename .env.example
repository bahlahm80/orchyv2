# Google AI Studio key: https://aistudio.google.com/apikey
# Free-tier Flash models work for local matching + chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resume is injected into every match/chat call as guardrail context.
RESUME_PATH=data/resume.md

# Application worker only surfaces new jobs when in-progress count is below this.
MAX_IN_PROGRESS=5
MATCH_THRESHOLD=0.72

# LinkedIn public job search (no login). Set JOB_SOURCE=sample to skip the network.
JOB_SOURCE=auto
LINKEDIN_KEYWORDS=software engineer python
LINKEDIN_LOCATION=United States
LINKEDIN_GEO_ID=

SEARCH_INTERVAL_SECONDS=180
MANAGER_TICK_SECONDS=15

HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/jobhelper.db
